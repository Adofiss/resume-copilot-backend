# Server
PORT=3000
CORS_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to the extension
# SUPABASE_JWT_SECRET is NOT used by this codebase — this project's Supabase
# instance signs tokens with ES256 (asymmetric keys), verified via the JWKS
# endpoint in auth.js instead. Left unset intentionally; harmless if present.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare Turnstile (bot protection on signup/login)
TURNSTILE_SECRET_KEY=0x...

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Pricing: score is free/unlimited. Tailor + cover letter cost 1 credit each,
# or are unlimited on the subscription. Create these as Prices in the Stripe
# dashboard and paste the price IDs here.
STRIPE_PRICE_ID_MONTHLY=price_...        # $8.99/mo recurring, unlimited tailor + cover letter
STRIPE_PRICE_ID_CREDIT_SINGLE=price_...  # $0.99 one-time, 1 credit
STRIPE_PRICE_ID_CREDIT_TEN=price_...     # $7.99 one-time, 10 credits

# Where the password-reset email links back to (marketing/reset-password.html, hosted on Netlify).
RESET_PASSWORD_URL=https://resume-copilot.com/reset-password
CHECKOUT_SUCCESS_URL=https://resume-copilot.com/upgrade-success
CHECKOUT_CANCEL_URL=https://resume-copilot.com/upgrade-cancel
